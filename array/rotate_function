class Solution(object):
    def maxRotateFunction(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        # maxi = -1
        n = len(nums)
        total = sum(nums)

        f = sum(i *num for i,num in enumerate(nums))
        maxi = f

        for k in range(1,n):
            f = f + total - n * nums[n-k]
            maxi = max(maxi,f)
        return maxi

        
            



                